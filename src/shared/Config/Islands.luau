--!strict
-- Island definitions (GDD A12). Names come from the Island Pacing tab's
-- Theme column; costs from its Egg cost and unlock cost columns.
-- unlockCost is the Coins to unlock this island; island 1 is free.
--
-- GENERATED by tools/gen_config.py from the tuning sheet and docs/rosters.csv (GDD A12a).
-- Don't edit by hand: change the sheet or roster, then run
-- `python tools/gen_config.py`.

export type IslandDef = {
	id: string,
	-- Order of play, starting at 1.
	number: number,
	name: string,
	unlockCost: number,
	unlockCurrency: string,
	egg: string,
}

local list: { IslandDef } = {
	{
		id = "NinjaVillage",
		number = 1,
		name = "Ninja village",
		unlockCost = 0,
		unlockCurrency = "coins",
		egg = "ninja_village_egg",
	},
	{
		id = "CursedCity",
		number = 2,
		name = "Cursed-spirit city",
		unlockCost = 1200,
		unlockCurrency = "coins",
		egg = "cursed_city_egg",
	},
}

-- Islands by id.
local Islands: { [string]: IslandDef } = {}
for _, def in list do
	Islands[def.id] = table.freeze(def)
end

return table.freeze(Islands)
